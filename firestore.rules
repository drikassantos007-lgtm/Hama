rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só a sua conta (UID) lê e escreve. Troque pelo UID do seu usuário.
    match /encomendas/{id} {
      allow read, write: if request.auth != null
                         && request.auth.uid == "y6NoxFw9xmcxyZmvdVbfjMSlvHC2";
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
